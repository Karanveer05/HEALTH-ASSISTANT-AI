# Copy this file to .env and fill in what you need. Everything is optional.

# --- AI model (free keys) ---
# Gemini: https://aistudio.google.com/apikey     Groq: https://console.groq.com/keys
# With no key the app runs on its built-in rule engine.
GEMINI_API_KEY=
GROQ_API_KEY=
# auto | gemini | groq | offline
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

# --- Database --- (default: SQLite file in backend/storage)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/healthassist

# --- Security --- (generated automatically into storage/keys.json if empty)
SECRET_KEY=
FERNET_KEY=
TOKEN_MINUTES=60

# --- Other ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
LIVE_PRICES=true
PRICE_CACHE_HOURS=24
